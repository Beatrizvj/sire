rules_version = '2';

// Reglas de seguridad de SIRE — acceso por rol CON aprobación (R1).
// Roles: ciudadano · cocode · auxiliatura · municipalidad (campo `rol` en
// usuarios/{uid}). La Alcaldía Auxiliar tiene los permisos del COCODE en su aldea.
// Estado de cuenta: pendiente_revision · aprobado · rechazado · suspendido
//   (campo `estadoCuenta`). Los documentos ANTIGUOS sin ese campo se consideran
//   'aprobado' para no bloquear a los usuarios que ya existían antes de R1.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfil del usuario autenticado (lectura privilegiada, no recursiva).
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    // Compatibilidad: si el doc no tiene `estadoCuenta`, se asume 'aprobado'.
    function estadoActual() {
      return perfil().get('estadoCuenta', 'aprobado');
    }
    function aprobado() {
      return signedIn() && estadoActual() == 'aprobado';
    }
    // El rol solo cuenta si la cuenta está aprobada.
    function esMunicipalidad() {
      return aprobado() && perfil().rol == 'municipalidad';
    }
    // Autoridad de aldea: COCODE o Alcaldía Auxiliar (mismos permisos, solo en
    // SU aldea).
    function esCocode() {
      return aprobado() && perfil().rol in ['cocode', 'auxiliatura'];
    }
    function miAldea() {
      return perfil().get('aldea', '');
    }
    // Coordinador del COCODE o de la Alcaldía Auxiliar de SU aldea (campo
    // `esResponsable`). Solo la Municipalidad lo designa. Aprueba cuentas,
    // gestiona a los integrantes de su aldea y delega la aprobación.
    function esCoordinador() {
      return esCocode() && perfil().get('esResponsable', false) == true;
    }
    // Aprueba cuentas de su aldea: el coordinador o un integrante con la
    // aprobación delegada (`puedeVerIdentidad`).
    function esAprobador() {
      return esCoordinador()
             || (esCocode() && perfil().get('puedeVerIdentidad', false) == true);
    }
    // Ni el dueño ni una autoridad de aldea pueden tocar estas capacidades:
    // solo la Municipalidad las otorga.
    function capacidadesIntactas() {
      return request.resource.data.get('puedeVerIdentidad', false)
               == resource.data.get('puedeVerIdentidad', false)
             && request.resource.data.get('esResponsable', false)
               == resource.data.get('esResponsable', false);
    }
    // R2: verificador de identidad = autoridad aprobada con la capacidad
    // `puedeVerIdentidad` que otorga la Municipalidad.
    function esVerificador() {
      return (aprobado() && perfil().get('puedeVerIdentidad', false) == true)
             || esCoordinador();
    }
    // Campos de identidad y de cuenta que el coordinador NO cambia al
    // gestionar a un integrante (la aldea y la coordinación son municipales).
    function identidadIntacta() {
      return request.resource.data.get('aldea', '') == resource.data.get('aldea', '')
             && request.resource.data.get('aldeaSolicitada', '') == resource.data.get('aldeaSolicitada', '')
             && request.resource.data.get('telefono', '') == resource.data.get('telefono', '')
             && request.resource.data.get('estadoCuenta', 'aprobado') == resource.data.get('estadoCuenta', 'aprobado')
             && request.resource.data.get('esResponsable', false) == resource.data.get('esResponsable', false);
    }
    // Bitácora: quien cambia un documento se identifica con `modificadoPor`
    // (su propio uid) y `modificadoEn` (hora del servidor), o deja ambos
    // intactos (versiones anteriores de la app; la bitácora lo registra como
    // actor desconocido). Nadie puede firmar a nombre de otro.
    function marcaActorValida() {
      return (request.resource.data.get('modificadoPor', '') == request.auth.uid
              && request.resource.data.get('modificadoEn', null) == request.time)
             || (request.resource.data.get('modificadoPor', '') == resource.data.get('modificadoPor', '')
                 && request.resource.data.get('modificadoEn', null) == resource.data.get('modificadoEn', null));
    }
    // R4 (capa servidor): nombre 2-60 caracteres, solo letras (Unicode),
    // espacios, apóstrofo y guion. La lista negra se aplica en el cliente.
    function nombreValido(n) {
      return n is string
             && n.size() >= 2 && n.size() <= 60
             && n.matches("[\\p{L}]+([ '\\-][\\p{L}]+)*");
    }

    // ── Perfiles de usuario ──
    match /usuarios/{userId} {
      // Al registrarse, cada quien crea SU propio perfil y OBLIGATORIAMENTE
      // 'pendiente_revision'. Nadie puede auto-crearse ya aprobado.
      allow create: if signedIn() && request.auth.uid == userId
                       && request.resource.data.get('estadoCuenta', '') == 'pendiente_revision'
                       && nombreValido(request.resource.data.nombre)
                       // Teléfono: exactamente 8 dígitos (Guatemala, sin +502).
                       && request.resource.data.get('telefono', '').matches('^[0-9]{8}$');

      // Lo lee su dueño; COCODE y Municipalidad (aprobados) pueden consultarlo.
      // Además, cualquier usuario aprobado puede leer el perfil del COCODE de SU
      // propia aldea (para tener su teléfono de contacto de emergencia); esto
      // NO expone a otros ciudadanos, solo al COCODE de la aldea del solicitante.
      allow read:   if signedIn() && (request.auth.uid == userId
                       || esMunicipalidad() || esCocode()
                       || (aprobado()
                           && resource.data.get('rol', 'ciudadano') == 'cocode'
                           && resource.data.get('aldea', '') == miAldea())
                       // ...y el coordinador de la Alcaldía Auxiliar de su aldea
                       // (para indicarle a quién acudir).
                       || (aprobado()
                           && resource.data.get('rol', 'ciudadano') == 'auxiliatura'
                           && resource.data.get('esResponsable', false) == true
                           && resource.data.get('aldea', '') == miAldea()));

      // El dueño edita SUS datos, pero NO su rol, su estado, la capacidad de
      // ver identidad ni sus contactos de confianza (RF-11): esos grupos solo
      // los arma una autoridad, no el propio ciudadano.
      allow update: if request.auth.uid == userId
                       && marcaActorValida()
                       && request.resource.data.get('rol', 'ciudadano')
                            == resource.data.get('rol', 'ciudadano')
                       && request.resource.data.get('estadoCuenta', 'aprobado')
                            == resource.data.get('estadoCuenta', 'aprobado')
                       && capacidadesIntactas()
                       && request.resource.data.get('contactosConfianza', [])
                            == resource.data.get('contactosConfianza', [])
                       // Identidad verificada contra el DPI: el dueño NO cambia
                       // su nombre ni su aldea (la aldea define a qué autoridad
                       // llegan sus alertas). Solo la Municipalidad los corrige.
                       && request.resource.data.get('nombre', '')
                            == resource.data.get('nombre', '')
                       && request.resource.data.get('aldea', '')
                            == resource.data.get('aldea', '')
                       && request.resource.data.get('aldeaSolicitada', '')
                            == resource.data.get('aldeaSolicitada', '')
                       // El teléfono sí es editable, siempre con 8 dígitos (si no
                       // cambia, no se revalida: otras escrituras del dueño, como
                       // el token de notificaciones, no deben fallar).
                       && (request.resource.data.get('telefono', '')
                             == resource.data.get('telefono', '')
                           || request.resource.data.get('telefono', '').matches('^[0-9]{8}$'));

      // La Municipalidad puede aprobar/editar cualquier cuenta y asignar rol.
      allow update: if esMunicipalidad() && marcaActorValida();

      // APROBACIÓN de solicitudes de SU aldea: coordinador o aprobador
      // delegado. El delegado solo aprueba ciudadanos; el coordinador también
      // a integrantes de su propio cuerpo (COCODE o Alcaldía Auxiliar). Al
      // rechazar, la aldea no cambia.
      allow update: if esAprobador()
                       && marcaActorValida()
                       && resource.data.get('estadoCuenta', 'aprobado') == 'pendiente_revision'
                       && resource.data.get('aldeaSolicitada', '') == miAldea()
                       && (request.resource.data.get('rol', 'ciudadano') == 'ciudadano'
                           || (esCoordinador()
                               && request.resource.data.get('rol', '') == perfil().rol))
                       && (request.resource.data.get('aldea', '') == miAldea()
                           || request.resource.data.get('estadoCuenta', '') == 'rechazado')
                       && capacidadesIntactas();

      // GESTIÓN por el coordinador de los integrantes YA aprobados de su aldea
      // (nunca de sí mismo ni de otro coordinador): cambia el rol entre
      // ciudadano y su propio cuerpo, corrige el nombre, arma los contactos de
      // confianza (RF-11) y delega la aprobación solo a integrantes de su cuerpo.
      allow update: if esCoordinador()
                       && marcaActorValida()
                       && userId != request.auth.uid
                       && resource.data.get('aldea', '') == miAldea()
                       && resource.data.get('esResponsable', false) == false
                       && resource.data.get('rol', 'ciudadano') in ['ciudadano', perfil().rol]
                       && request.resource.data.get('rol', 'ciudadano') in ['ciudadano', perfil().rol]
                       && identidadIntacta()
                       && nombreValido(request.resource.data.nombre)
                       && (request.resource.data.get('puedeVerIdentidad', false) == false
                           || request.resource.data.get('rol', '') == perfil().rol);

      // El propio usuario puede borrar su cuenta (requisito de Google Play);
      // una Cloud Function elimina además su acceso y sus fotos del DPI.
      allow delete: if esMunicipalidad() || request.auth.uid == userId;
    }

    // ── Auditoría (R1): bitácora inmutable ──
    match /auditoria/{id} {
      // Solo autoridades aprobadas registran acciones; el actor debe ser quien firma.
      allow create: if (esMunicipalidad() || esCocode())
                       && request.resource.data.actorUid == request.auth.uid;
      // La Municipalidad lee toda la bitácora; el coordinador del COCODE o de
      // la Alcaldía Auxiliar, la de SU aldea; los demás integrantes, solo el
      // historial de las alertas de su aldea (sus consultas DEBEN filtrar por
      // aldea y, los integrantes, por objetivoTipo == 'alerta').
      allow read:   if esMunicipalidad()
                       || (esCoordinador()
                           && resource.data.get('aldea', '') == miAldea())
                       || (esCocode()
                           && resource.data.get('aldea', '') == miAldea()
                           && resource.data.get('objetivoTipo', '') == 'alerta');
      // Inmutable: nunca se edita ni se borra.
      allow update, delete: if false;
    }

    // ── Identidad (R2): fotos del DPI, privadas ──
    // Cada lado en su propio documento: identidad/{uid}/fotos/{lado}.
    match /identidad/{uid} {
      allow read: if esVerificador();
      allow write, delete: if request.auth.uid == uid || esMunicipalidad();

      match /fotos/{lado} {
        // El dueño sube/actualiza SUS propias fotos (durante el registro).
        allow write:  if signedIn() && request.auth.uid == uid;
        // Solo verificadores autorizados por la Municipalidad pueden verlas.
        allow read:   if esVerificador();
        // La Municipalidad (o el dueño) pueden eliminarlas.
        allow delete: if esMunicipalidad() || request.auth.uid == uid;
      }
    }

    // ── Categorías de incidente (R3): catálogo configurable ──
    match /categorias_incidente/{id} {
      // Cualquier usuario aprobado las lee (para el selector del ciudadano).
      allow read: if aprobado();
      // Solo la Municipalidad las administra.
      allow create, update, delete: if esMunicipalidad();
    }

    // ── Alertas de emergencia ──
    match /alertas/{alertaId} {
      // El ciudadano (aprobado) crea su propia alerta (idUsuario debe ser el suyo).
      allow create: if aprobado()
                       && request.resource.data.idUsuario == request.auth.uid;
      // Ruteo por aldea: la Municipalidad lee TODAS las alertas; cada COCODE,
      // SOLO las de su aldea (por eso su consulta DEBE filtrar por aldea). El
      // dueño lee la suya. RF-11: un ciudadano aprobado también lee las alertas
      // de los contactos de confianza que UNA AUTORIDAD le asignó (alarma).
      allow read:   if signedIn() && (
                       resource.data.idUsuario == request.auth.uid
                       || esMunicipalidad()
                       || (esCocode()
                           && resource.data.get('aldea', '') == miAldea())
                       || (aprobado()
                           && resource.data.idUsuario
                                in perfil().get('contactosConfianza', []))
                    );
      // La Municipalidad cambia el estado de cualquier alerta; el COCODE, solo
      // las de SU aldea. Además, el ciudadano puede CANCELAR su propia alerta
      // (marcarla 'falsa_alarma') mientras siga abierta: basta con que sea SU
      // alerta y que el cambio sea SOLO a 'falsa_alarma'.
      allow update: if marcaActorValida() && (
                       esMunicipalidad()
                       || (esCocode()
                           && resource.data.get('aldea', '') == miAldea())
                       || (resource.data.idUsuario == request.auth.uid
                           && request.resource.data.estado == 'falsa_alarma'));
      // Ubicación EN VIVO: el teléfono del dueño actualiza SOLO su posición
      // actual, y solo mientras la alerta siga abierta (pendiente o atendida).
      allow update: if resource.data.idUsuario == request.auth.uid
                       && resource.data.estado in ['pendiente', 'atendida']
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['latitudActual', 'longitudActual',
                                      'precisionActual', 'ubicacionActualEn'])
                       && request.resource.data.latitudActual is number
                       && request.resource.data.longitudActual is number
                       && request.resource.data.ubicacionActualEn == request.time;
      allow delete: if esMunicipalidad();
    }

    // ── Aldeas / comunidades del municipio (catálogo administrable) ──
    // Los nombres de las comunidades son públicos y no sensibles: cualquiera los
    // lee (el formulario de registro los necesita SIN sesión iniciada). Solo la
    // Municipalidad agrega o edita comunidades (escalabilidad descrita en el Cap. III).
    match /aldeas/{aldeaId} {
      allow read:  if true;
      allow write: if esMunicipalidad();
    }

    // ── Todo lo demás: denegado por defecto ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
