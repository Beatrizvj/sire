{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "sire-app-179d3",
          "appId": "1:1022970608171:android:1520056053c87211a1086e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "sire-app-179d3",
          "configurations": {
            "android": "1:1022970608171:android:1520056053c87211a1086e",
            "web": "1:1022970608171:web:76fbec8e745bbe58a1086e"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/@(flutter_service_worker.js|flutter_bootstrap.js|main.dart.js|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
